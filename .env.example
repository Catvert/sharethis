# Docker Hub username (required for build/deploy scripts)
DOCKER_USER=your-username

# Server port
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default):   sqlite://sharethis.db?mode=rwc   (absolute: sqlite:///app/data/sharethis.db?mode=rwc)
# MariaDB / MySQL:    mariadb://user:password@host:3306/sharethis
# When DATABASE_URL is empty, DATABASE_PATH is used as a SQLite file path.
DATABASE_URL=
DATABASE_PATH=sharethis.db

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
# Directory where uploaded files are stored (one file per upload).
# Legacy BLOBs found in an existing SQLite database are moved here on startup.
STORAGE_DIR=data/files

# Maximum size of a file stored on the server, in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Files larger than this are shared peer-to-peer over WebRTC and never
# uploaded to the server (default: 5MB)
P2P_THRESHOLD=5242880

# Quotas
# bytes stored per room (100MB)
ROOM_QUOTA=104857600
MAX_FILES_PER_ROOM=50
# bytes stored on the server, all rooms (5GB)
STORAGE_QUOTA=5368709120

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# max size of the shared text (1MB)
MAX_CONTENT_SIZE=1048576
# rooms kept in memory
MAX_ROOMS=10000
# simultaneous WebSocket connections per IP
MAX_WS_PER_IP=20
# seconds an empty open room is kept (text + files)
ROOM_IDLE_GRACE=300

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Set to true ONLY behind a reverse proxy (Caddy, nginx...) that sets
# X-Forwarded-For, otherwise clients can spoof their IP and bypass rate limits.
TRUST_PROXY=false
# Header carrying the visitor IP, set by an edge proxy in front of the reverse
# proxy, e.g. CF-Connecting-IP behind Cloudflare. Takes precedence over
# X-Forwarded-For. Set it ONLY if the app cannot be reached without going
# through that edge proxy, otherwise clients can spoof it. Empty = disabled.
IP_HEADER=
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# bcrypt work factor for room passwords (4-31)
BCRYPT_COST=12
# Period of the background cleanup task, in seconds
SWEEP_INTERVAL=30
