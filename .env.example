# Docker Hub username (required for build/deploy scripts)
DOCKER_USER=your-username

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Server port
PORT=3000

# Enable P2P file sharing for files larger than this size (bytes)
# Files smaller will be stored in SQLite, larger will use WebRTC P2P
P2P_THRESHOLD=5242880

# Database path (default: sharethis.db in current directory)
DATABASE_PATH=sharethis.db
